# App prod environment.
# Copy to docker/prod/.env on the server or create from CI secrets.
# Sensitive values — in docker/prod/override.env (не коммитить).

APP_ENV=prod
APP_DEBUG=false
SERVER_NAME=:80

# 32 байта raw или base64(32 байта). В проде — в override.env
APP_SECRET=prod-change-me-to-32byte-secret!

# Публичный HTTPS URL приложения (для Telegram webhook)
APP_PUBLIC_URL=https://botato.example

# Прокси до api.telegram.org (обязателен при блокировках в РФ).
# DNS через прокси: socks5h://user:pass@host:1080
# Без DNS через прокси: socks5://host:1080  или  http://host:8080
# TELEGRAM_PROXY=socks5h://user:pass@proxy-host:1080

DB_DSN=pgsql:host=postgres;port=5432;dbname=botato
DB_USER=app
DB_PASSWORD=change_me

REDIS_HOST=redis
REDIS_PORT=6379

MAILER_FROM=botato@list.ru
MAILER_SMTP_HOST=smtp.mail.ru
MAILER_SMTP_PORT=465
# Пароль приложения Mail.ru — в docker/prod/override.env (не коммитить)
