# App prod environment.
# Copy to docker/prod/.env on the server or create from CI secrets.
# Sensitive values — in docker/prod/override.env (не коммитить).

APP_ENV=prod
APP_DEBUG=false
SERVER_NAME=:80

DB_DSN=pgsql:host=postgres;port=5432;dbname=botato
DB_USER=app
DB_PASSWORD=change_me

MAILER_FROM=botato@list.ru
MAILER_SMTP_HOST=smtp.mail.ru
MAILER_SMTP_PORT=465
# Пароль приложения Mail.ru — в docker/prod/override.env (не коммитить)
