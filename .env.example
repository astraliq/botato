# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true

# Прокси до api.telegram.org (при блокировках). Пример: socks5h://user:pass@host:1080
# TELEGRAM_PROXY=

# Базовый URL webhook (VPS-relay). Если пусто — APP_PUBLIC_URL.
# TELEGRAM_WEBHOOK_BASE_URL=https://tg-hook.example
